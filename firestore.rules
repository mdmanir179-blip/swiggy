rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /workspace/{docId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
  }
}
